{
    "version": 2,
    "builds": [{
            "src": "api/index.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/index.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [{
            "src": "/analyze",
            "dest": "api/index.py"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/$1"
        }
    ]
}